# 邮件发送配置示例
# 复制此文件为 .env 并填入你的实际配置
# 注意：.env 文件应添加到 .gitignore，不要上传到 GitHub

# SMTP 服务器配置
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465

# 邮箱账户（使用授权码而非主密码）
SMTP_EMAIL=your_email@qq.com
SMTP_AUTH_CODE=your_authorization_code_here

# 默认收件人（可选）
DEFAULT_RECIPIENT=your_email@qq.com

# 邮件格式（plain 或 html）
EMAIL_FORMAT=plain
